### 数据模型和验证

#### Pydantic v2 规范

- **使用Field()配置验证** - 替代v1的Config类
- **模型配置** - 使用model_config替代Config内部类
- **序列化别名** - 使用alias_generator和serialization_alias

```python
from pydantic import BaseModel, Field, ConfigDict, field_validator
from datetime import datetime
from typing import Optional

class NovelCreateRequest(BaseModel):
    """小说创建请求模型"""
    model_config = ConfigDict(
        # 启用属性验证，提高数据安全性
        validate_assignment=True,
        # 使用枚举值而非枚举名称进行序列化
        use_enum_values=True,
        # 自动转换JSON字段名为snake_case
        alias_generator=lambda field_name: field_name.replace('_', '-')
    )

    title: str = Field(..., min_length=1, max_length=200, description="小说标题")
    genre: str = Field(..., description="小说类型")
    target_length: int = Field(default=50000, ge=1000, description="目标字数")
    author_notes: Optional[str] = Field(None, max_length=1000, description="作者备注")

    # 自定义验证器使用v2语法
    @field_validator('genre')
    @classmethod
    def validate_genre(cls, v: str) -> str:
        """验证小说类型是否在支持范围内"""
        allowed_genres = ['科幻', '言情', '悬疑', '武侠', '历史']
        if v not in allowed_genres:
            raise ValueError(f'不支持的小说类型: {v}')
        return v
```

### 数据库操作

#### SQLAlchemy 2.x 规范

- **使用异步语法** - 优先使用AsyncSession和async/await
- **新式查询语法** - 使用select()而非Query API
- **类型注解** - 明确指定模型和查询返回类型

```python
from sqlalchemy import select, update, delete
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy.orm import selectinload
from typing import List, Optional

class NovelRepository:
    """小说数据访问层"""

    def __init__(self, session: AsyncSession):
        self.session = session

    async def create_novel(self, novel_data: Dict) -> Novel:
        """创建新小说记录"""
        # 使用SQLAlchemy 2.x的新式语法创建对象
        novel = Novel(**novel_data)
        self.session.add(novel)
        await self.session.commit()
        await self.session.refresh(novel)  # 获取数据库生成的字段
        return novel

    async def get_novel_by_id(self, novel_id: int) -> Optional[Novel]:
        """根据ID获取小说，预加载关联数据提升性能"""
        stmt = (
            select(Novel)
            .where(Novel.id == novel_id)
            .options(selectinload(Novel.chapters))  # 预加载章节数据
        )
        result = await self.session.execute(stmt)
        return result.scalar_one_or_none()

    async def update_novel_status(self, novel_id: int, status: str) -> bool:
        """批量更新小说状态，避免先查询再更新的性能损耗"""
        stmt = (
            update(Novel)
            .where(Novel.id == novel_id)
            .values(status=status, updated_at=datetime.utcnow())
        )
        result = await self.session.execute(stmt)
        await self.session.commit()
        return result.rowcount > 0

    async def get_popular_novels(self, limit: int = 10) -> List[Novel]:
        """获取热门小说列表，使用索引优化查询"""
        stmt = (
            select(Novel)
            .where(Novel.status == 'published')
            .order_by(Novel.popularity_score.desc())
            .limit(limit)
        )
        result = await self.session.execute(stmt)
        return list(result.scalars().all())
```

#### 数据库模型定义

```python
from sqlalchemy import String, Integer, DateTime, Text, ForeignKey
from sqlalchemy.orm import DeclarativeBase, Mapped, mapped_column, relationship
from datetime import datetime
from typing import List, Optional

class Base(DeclarativeBase):
    """数据库模型基类"""
    pass

class Novel(Base):
    """小说模型"""
    __tablename__ = 'novels'

    # 使用Mapped类型注解，提供更好的类型支持
    id: Mapped[int] = mapped_column(Integer, primary_key=True)
    title: Mapped[str] = mapped_column(String(200), nullable=False, index=True)
    genre: Mapped[str] = mapped_column(String(50), nullable=False, index=True)
    content: Mapped[Optional[str]] = mapped_column(Text, nullable=True)

    # 时间戳字段使用默认值
    created_at: Mapped[datetime] = mapped_column(
        DateTime,
        nullable=False,
        default_factory=datetime.utcnow
    )
    updated_at: Mapped[Optional[datetime]] = mapped_column(DateTime, nullable=True)

    # 关系定义使用新式语法
    chapters: Mapped[List["Chapter"]] = relationship(
        "Chapter",
        back_populates="novel",
        cascade="all, delete-orphan"  # 删除小说时级联删除章节
    )
```

### 异步编程规范

#### FastAPI集成最佳实践

```python
from fastapi import FastAPI, Depends, HTTPException
from sqlalchemy.ext.asyncio import AsyncSession

@app.post("/novels/", response_model=NovelResponse)
async def create_novel(
    request: NovelCreateRequest,
    session: AsyncSession = Depends(get_db_session)
) -> NovelResponse:
    """创建新小说"""
    try:
        # 使用依赖注入获取数据库会话，便于测试和维护
        repository = NovelRepository(session)
        novel = await repository.create_novel(request.model_dump())

        # 返回Pydantic模型，自动处理序列化
        return NovelResponse.model_validate(novel)

    except ValueError as e:
        # 业务逻辑错误返回400状态码
        raise HTTPException(status_code=400, detail=str(e))
    except Exception as e:
        # 系统错误记录日志并返回500状态码
        logger.error(f"创建小说失败: {e}")
        raise HTTPException(status_code=500, detail="服务器内部错误")
```

