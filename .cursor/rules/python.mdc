#### ✅ 正确示例：使用配置和常量

```python
from pydantic_settings import BaseSettings
from enum import Enum
from pathlib import Path
from typing import Dict

class Settings(BaseSettings):
    """应用配置，支持环境变量覆盖"""
    # 数据库配置通过环境变量获取
    db_host: str = "localhost"
    db_port: int = 5432
    db_user: str = "postgres"
    db_password: str = ""

    # API配置
    openai_api_key: str = ""
    max_tokens: int = 4000

    # 文件存储配置
    upload_dir: Path = Path("./uploads")
    temp_dir: Path = Path("./temp")

    class Config:
        env_file = ".env"
        env_prefix = "APP_"

# 用户等级常量定义
class UserLevel(Enum):
    """用户等级枚举"""
    BASIC = "Basic"
    PREMIUM = "Premium"
    VIP = "VIP"

# 业务规则常量
class BusinessRules:
    """业务规则常量集中管理"""
    # 用户等级积分阈值
    USER_LEVEL_THRESHOLDS: Dict[UserLevel, int] = {
        UserLevel.VIP: 10000,
        UserLevel.PREMIUM: 1000,
        UserLevel.BASIC: 0
    }

    # 小说相关限制
    MIN_CHAPTER_LENGTH = 800
    MAX_CHAPTER_LENGTH = 3000
    MAX_DAILY_CHAPTERS = 5

    # AI生成参数
    DEFAULT_TEMPERATURE = 0.7
    MAX_RETRY_ATTEMPTS = 3

# 正确的实现方式
settings = Settings()

def get_database_connection():
    """使用配置获取数据库连接"""
    return create_connection(
        host=settings.db_host,
        port=settings.db_port,
        user=settings.db_user,
        password=settings.db_password
    )

def check_user_level(points: int) -> UserLevel:
    """根据积分判断用户等级，使用配置化的阈值"""
    thresholds = BusinessRules.USER_LEVEL_THRESHOLDS

    for level, min_points in sorted(thresholds.items(),
                                   key=lambda x: x[1],
                                   reverse=True):
        if points >= min_points:
            return level

    return UserLevel.BASIC

def save_novel_content(content: str, filename: str = "draft.txt"):
    """使用配置的路径保存文件"""
    # 确保目录存在
    settings.temp_dir.mkdir(parents=True, exist_ok=True)

    file_path = settings.temp_dir / filename
    with open(file_path, "w", encoding="utf-8") as f:
        f.write(content)

    return file_path
```

